<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IrisXe.Thermal.App</RootNamespace>
    <AssemblyName>IrisXeThermalReader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>IRIS XE THERMAL MSR READER</Product>
    <Description>Diagnostico termico (somente leitura) para o Intel Core i7-1195G7. Fase 1: sem driver.</Description>
    <!-- Permite compilar/publicar o WinForms para Windows a partir de um host nao-Windows
         (cross-compile de validacao). Em producao, compile no proprio Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IrisXe.Thermal.Core\IrisXe.Thermal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
